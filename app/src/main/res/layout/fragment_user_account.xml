<?xml version="1.0" encoding="utf-8"?>
<ScrollView  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">
 <LinearLayout
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_55sdp"
        android:padding="@dimen/_8sdp"
        android:background="@color/white"
        android:layout_marginBottom="@dimen/_10sdp">
        <com.jogiprasadpakki.android.CircularImageView
            android:id="@+id/img_user_profile"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:src="@drawable/user"
            android:scaleType="centerCrop"
            app:civ_border_width="0.5dp"
            app:civ_border_color="@color/quantum_bluegrey300"
            android:layout_centerVertical="true"/>

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/btn_account_login"
            android:text="@string/login"
            android:background="@drawable/stroke_button"
            android:layout_centerHorizontal="true"
            android:textColor="@color/colorPrimary"
            android:textAllCaps="false"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/ll_account_user_info"
            android:layout_toRightOf="@id/img_user_profile"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_8sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_account_name"
                android:textSize="@dimen/_15ssp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_account_mobile"
                android:textSize="@dimen/_10ssp" />

        </LinearLayout>
        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:id="@+id/img_usr_edit_profile"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_10sdp"
            app:srcCompat="@drawable/ic_edit"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/ll_my_orders"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            app:srcCompat="@drawable/ic_truck"
            android:layout_gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_orders"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/_10ssp"
            android:layout_marginStart="@dimen/_5sdp" />


    </LinearLayout>
    <include layout="@layout/horizontal_line"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/ll_my_address"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            app:srcCompat="@drawable/ic_map"
            android:layout_gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_address"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/_10ssp"
            android:layout_marginStart="@dimen/_5sdp" />


    </LinearLayout>
    <include layout="@layout/horizontal_line"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:orientation="horizontal"
        android:id="@+id/ll_account_rate"
        android:background="@color/white"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            app:srcCompat="@drawable/ic_thumbs_up"
            android:layout_gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rate_us"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/_10ssp"
            android:layout_marginStart="@dimen/_5sdp" />


    </LinearLayout>
    <include layout="@layout/horizontal_line"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/ll_account_feedback"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            app:srcCompat="@drawable/ic_writing"
            android:layout_gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/_10ssp"
            android:layout_marginStart="@dimen/_5sdp" />


    </LinearLayout>
    <include layout="@layout/horizontal_line"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/ll_account_about"
        android:orientation="horizontal"
        android:background="@color/white"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp">

        <ImageView
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            app:srcCompat="@drawable/ic_about"
            android:layout_gravity="center_vertical"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/_10ssp"
            android:layout_marginStart="@dimen/_5sdp" />


    </LinearLayout>
    <include layout="@layout/horizontal_line"/>


    </LinearLayout>
</ScrollView>